{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "famo-sync-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist-sync",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SYNC_EVENTS", "class_name": "SyncEvents" }]
  },
  "migrations": [
    { "tag": "sync-events-v1", "new_sqlite_classes": ["SyncEvents"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "famo-sync-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
